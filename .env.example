# OpenRouter API key (server-side only, never exposed to the browser).
# Get one at https://openrouter.ai/settings/keys
OPEN_ROUTER_API=sk-or-v1-your-key-here

# Key tier: set to "paid" if the key has credits (uses quality-first paid
# models with free fallbacks). Leave unset / any other value for a free-tier
# key (uses free models only, avoiding wasted 402 round-trips).
# OPENROUTER_TIER=paid

# Optional: override the model fallback list (comma-separated OpenRouter model IDs).
# OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenTikZ pipeline also accepts OPENROUTER_API_KEY as an alias for OPEN_ROUTER_API.
# Embedding model defaults to openai/text-embedding-3-small (via OpenRouter).

# ---------------------------------------------------------------------------
# Safety: LLM moderation (Llama Guard via OpenRouter)
# ---------------------------------------------------------------------------
# Moderator model for semantic input screening.
# Default: openai/gpt-4o-mini (follows the teXlab allow-list policy).
# Llama Guard alone is NOT recommended — it often ignores custom product policy.
# MODERATION_MODEL=openai/gpt-4o-mini
#
# When the moderator is unreachable: default is fail-closed (block the request).
# Set to "true" only for local debugging.
# MODERATION_FAIL_OPEN=false
#
# Skip moderation entirely (local only — never in production).
# MODERATION_DISABLED=false

# ---------------------------------------------------------------------------
# OpenRouter dashboard guardrails (ops — cannot be set from this repo)
# ---------------------------------------------------------------------------
# If you control the OpenRouter workspace for OPEN_ROUTER_API, assign a
# guardrail to the production key at:
#   https://openrouter.ai → Workspaces → Guardrails
# Recommended (cost / governance only — not a substitute for Llama Guard):
#   - limit_usd + reset_interval (daily or monthly)
#   - allowed_models: your generation models + embedding + MODERATION_MODEL
#   - optional PII builtins: email / credit-card (redact or block)
# Do NOT rely on regex-prompt-injection as the main content defense.

# ---------------------------------------------------------------------------
# Durable rate limits (Upstash Redis)
# ---------------------------------------------------------------------------
# Without these, the API falls back to an in-memory limiter (resets on cold start).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx
#
# Generation endpoints (/api/generate, /api/generate-latex):
# RATE_LIMIT_BURST=8
# RATE_LIMIT_BURST_WINDOW_MS=60000
# RATE_LIMIT_HOUR=40
# RATE_LIMIT_DAY=100
#
# Compile endpoint (/api/compile-latex) uses looser defaults:
# RATE_LIMIT_COMPILE_BURST=30
# RATE_LIMIT_COMPILE_HOUR=200
