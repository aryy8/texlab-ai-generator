# OpenRouter API key (server-side only, never exposed to the browser).
# Get one at https://openrouter.ai/settings/keys
OPEN_ROUTER_API=sk-or-v1-your-key-here

# Key tier: set to "paid" if the key has credits (uses quality-first paid
# models with free fallbacks). Leave unset / any other value for a free-tier
# key (uses free models only, avoiding wasted 402 round-trips).
# OPENROUTER_TIER=paid

# Optional: override the model fallback list (comma-separated OpenRouter model IDs).
# OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenTikZ pipeline also accepts OPENROUTER_API_KEY as an alias for OPEN_ROUTER_API.
# Embedding model defaults to openai/text-embedding-3-small (via OpenRouter).
