# OpenRouter API key (server-side only, never exposed to the browser).
# Get one at https://openrouter.ai/settings/keys
OPEN_ROUTER_API=sk-or-v1-your-key-here

# Optional: override the model fallback list (comma-separated OpenRouter model IDs).
# OPENROUTER_MODEL=google/gemini-2.5-flash,openai/gpt-5-mini
